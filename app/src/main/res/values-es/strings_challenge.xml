    <string name="challenge_intro_help">Cómo funcionan los retos</string>
    <string name="challenge_intro_to_hub">A los retos</string>
    <string name="challenge_intro_open">Abrir</string>
    <string name="challenge_intro_title_1">Un juego para dos</string>
    <string name="challenge_intro_tip_1a">Una persona crea el reto y la otra lo cumple.</string>
    <string name="challenge_intro_tip_1b">PoseGuard vigila el intento y redacta un informe: no hace falta fiarse de la palabra de nadie.</string>
    <string name="challenge_intro_title_2">El autor fija las reglas</string>
    <string name="challenge_intro_tip_2a">Un reto lo incluye todo: duración, errores, penalizaciones, sensibilidad, regla de la cara, sonidos e Intiface.</string>
    <string name="challenge_intro_tip_2b">La duración y las penalizaciones se pueden ocultar: el ejecutor solo las descubre durante el intento.</string>
    <string name="challenge_intro_title_3">Enviar un reto</string>
    <string name="challenge_intro_tip_3a">Envía el reto como archivo, como código en cualquier mensajería o muestra su código QR.</string>
    <string name="challenge_intro_tip_3b">Para abrirlo, toca el archivo en la mensajería o usa los botones Archivo, Código y QR.</string>
    <string name="challenge_intro_tip_3c">Un reto con archivos de audio solo se envía como archivo.</string>
    <string name="challenge_intro_title_4">Cumplir un reto</string>
    <string name="challenge_intro_tip_4a">Acepta el reto y cúmplelo como una sesión normal, con las reglas del autor.</string>
    <string name="challenge_intro_tip_4b">Detener significa rendirse. Hay informe sea cual sea el resultado.</string>
    <string name="challenge_intro_tip_4c">El autor puede limitar el número de intentos.</string>
    <string name="challenge_intro_title_5">El informe</string>
    <string name="challenge_intro_tip_5a">Envía el informe al autor con un botón. Solo el autor puede abrirlo.</string>
    <string name="challenge_intro_tip_5b">Incluye el resultado, la cronología de infracciones y una repetición de los movimientos.</string>
    <string name="challenge_intro_tip_5c">PoseGuard recalcula el informe y muestra si el resultado está confirmado.</string>
    <string name="challenge_intiface_unavailable">El dispositivo Intiface requerido se ha desconectado. La sesión se ha detenido.</string>
    <string name="report_cause_intiface_unavailable">El dispositivo Intiface requerido se ha desconectado</string>
