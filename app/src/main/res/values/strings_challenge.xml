    <string name="challenge_intro_help">How challenges work</string>
    <string name="challenge_intro_to_hub">To challenges</string>
    <string name="challenge_intro_open">Open</string>
    <string name="challenge_intro_title_1">A game for two</string>
    <string name="challenge_intro_tip_1a">One person makes up a challenge, the other one does it.</string>
    <string name="challenge_intro_tip_1b">PoseGuard watches the attempt and writes a report, so nobody has to take anyone’s word for it.</string>
    <string name="challenge_intro_title_2">The author sets the rules</string>
    <string name="challenge_intro_tip_2a">A challenge holds everything: duration, errors, penalties, sensitivity, face rule, sounds and Intiface.</string>
    <string name="challenge_intro_tip_2b">The duration and the penalties can be hidden: the executor only finds out during the attempt.</string>
    <string name="challenge_intro_title_3">Sending a challenge</string>
    <string name="challenge_intro_tip_3a">Send the challenge as a file, as a code in any messenger, or show its QR code.</string>
    <string name="challenge_intro_tip_3b">To open one, tap the file in the messenger or use the File, Code and QR buttons.</string>
    <string name="challenge_intro_tip_3c">A challenge with audio files travels only as a file.</string>
    <string name="challenge_intro_title_4">Doing a challenge</string>
    <string name="challenge_intro_tip_4a">Accept the challenge and do it like a normal session, with the author’s rules.</string>
    <string name="challenge_intro_tip_4b">Stop means giving up. There is a report whatever the outcome.</string>
    <string name="challenge_intro_tip_4c">The author can limit the number of attempts.</string>
    <string name="challenge_intro_title_5">The report</string>
    <string name="challenge_intro_tip_5a">Send the report to the author with one button. Only the author can open it.</string>
    <string name="challenge_intro_tip_5b">It holds the result, the timeline of violations and a replay of the movements.</string>
    <string name="challenge_intro_tip_5c">PoseGuard recalculates the report and shows whether the result is confirmed.</string>
