    <string name="challenge_intro_help">Comment fonctionnent les défis</string>
    <string name="challenge_intro_to_hub">Vers les défis</string>
    <string name="challenge_intro_open">Ouvrir</string>
    <string name="challenge_intro_title_1">Un jeu à deux</string>
    <string name="challenge_intro_tip_1a">L’un invente un défi, l’autre le relève.</string>
    <string name="challenge_intro_tip_1b">PoseGuard surveille la tentative et rédige un rapport : inutile de croire qui que ce soit sur parole.</string>
    <string name="challenge_intro_title_2">L’auteur fixe les règles</string>
    <string name="challenge_intro_tip_2a">Un défi contient tout : durée, erreurs, pénalités, sensibilité, règle du visage, sons et Intiface.</string>
    <string name="challenge_intro_tip_2b">La durée et les pénalités peuvent être masquées : l’exécutant ne les découvre que pendant la tentative.</string>
    <string name="challenge_intro_title_3">Envoyer un défi</string>
    <string name="challenge_intro_tip_3a">Envoyez le défi en fichier, en code dans n’importe quelle messagerie, ou montrez son code QR.</string>
    <string name="challenge_intro_tip_3b">Pour en ouvrir un, touchez le fichier dans la messagerie ou utilisez les boutons Fichier, Code et QR.</string>
    <string name="challenge_intro_tip_3c">Un défi avec des fichiers audio ne s’envoie qu’en fichier.</string>
    <string name="challenge_intro_title_4">Relever un défi</string>
    <string name="challenge_intro_tip_4a">Acceptez le défi et relevez-le comme une séance normale, avec les règles de l’auteur.</string>
    <string name="challenge_intro_tip_4b">Arrêter veut dire abandonner. Il y a un rapport quelle que soit l’issue.</string>
    <string name="challenge_intro_tip_4c">L’auteur peut limiter le nombre de tentatives.</string>
    <string name="challenge_intro_title_5">Le rapport</string>
    <string name="challenge_intro_tip_5a">Envoyez le rapport à l’auteur d’un seul bouton. Seul l’auteur peut l’ouvrir.</string>
    <string name="challenge_intro_tip_5b">Il contient le résultat, la chronologie des infractions et un replay des mouvements.</string>
    <string name="challenge_intro_tip_5c">PoseGuard recalcule le rapport et indique si le résultat est confirmé.</string>
