    <string name="challenge_intro_help">Come funzionano le sfide</string>
    <string name="challenge_intro_to_hub">Alle sfide</string>
    <string name="challenge_intro_open">Apri</string>
    <string name="challenge_intro_title_1">Un gioco per due</string>
    <string name="challenge_intro_tip_1a">Uno inventa la sfida, l’altro la esegue.</string>
    <string name="challenge_intro_tip_1b">PoseGuard controlla il tentativo e scrive un resoconto: non serve fidarsi sulla parola.</string>
    <string name="challenge_intro_title_2">L’autore stabilisce le regole</string>
    <string name="challenge_intro_tip_2a">Una sfida contiene tutto: durata, errori, penalità, sensibilità, regola del viso, suoni e Intiface.</string>
    <string name="challenge_intro_tip_2b">Durata e penalità si possono nascondere: l’esecutore le scopre solo durante il tentativo.</string>
    <string name="challenge_intro_title_3">Inviare una sfida</string>
    <string name="challenge_intro_tip_3a">Invia la sfida come file, come codice in qualsiasi app di messaggi o mostra il suo codice QR.</string>
    <string name="challenge_intro_tip_3b">Per aprirne una, tocca il file nell’app di messaggi o usa i pulsanti File, Codice e QR.</string>
    <string name="challenge_intro_tip_3c">Una sfida con file audio si invia solo come file.</string>
    <string name="challenge_intro_title_4">Eseguire una sfida</string>
    <string name="challenge_intro_tip_4a">Accetta la sfida ed eseguila come una sessione normale, con le regole dell’autore.</string>
    <string name="challenge_intro_tip_4b">Stop significa arrendersi. Il resoconto c’è comunque vada.</string>
    <string name="challenge_intro_tip_4c">L’autore può limitare il numero di tentativi.</string>
    <string name="challenge_intro_title_5">Il resoconto</string>
    <string name="challenge_intro_tip_5a">Invia il resoconto all’autore con un pulsante. Solo l’autore può aprirlo.</string>
    <string name="challenge_intro_tip_5b">Contiene l’esito, la cronologia delle violazioni e un replay dei movimenti.</string>
    <string name="challenge_intro_tip_5c">PoseGuard ricalcola il resoconto e mostra se l’esito è confermato.</string>
